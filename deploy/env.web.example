# Copy to /opt/jobagent/.env.web on the VPS and fill in the real password
# (must match what you set in deploy/postgres_setup.sql).
DEPLOYMENT_MODE=web
DB_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
