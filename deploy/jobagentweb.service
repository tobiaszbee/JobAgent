[Unit]
Description=JobAgentWeb - multi-user job viewer (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User=jobagent
WorkingDirectory=/opt/jobagentweb
EnvironmentFile=/opt/jobagentweb/.env
ExecStart=/opt/jobagentweb/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
