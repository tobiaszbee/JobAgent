# Install as /etc/wireguard/wg0.conf on the VPS. Generate the server keypair ON
# THE VPS itself first (a private key should never travel over a channel that
# isn't already secure):
#   wg genkey | tee server_private.key | wg pubkey > server_public.key
#
# Add one [Peer] block per client (currently just your Windows machine). Generate
# the client's keypair on the Windows machine (WireGuard app: Add Tunnel > Add
# empty tunnel, it generates one automatically).

[Interface]
Address = 10.66.0.1/24
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>

[Peer]
# Windows machine
PublicKey = <CLIENT_PUBLIC_KEY>
AllowedIPs = 10.66.0.2/32
