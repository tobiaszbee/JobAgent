# Copy to /opt/jobagentweb/.env on the VPS and fill in real values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
# Must match the password set in deploy/postgres_setup.sql.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Signs the session cookie. Required — JobAgentWeb refuses to start without a
# real value. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# Shared invite code required at /register. Required to allow signups at all —
# unset means registration is closed entirely.
INVITE_CODE=CHANGE_ME_INVITE_CODE

# Optional. Lets one JobAgent desktop installation authenticate with a static
# key instead of a browser session cookie, so it never needs an interactive
# `scripts/login.py` re-run — immune to session expiry and the session_epoch
# logout mechanism. Both must be set together to activate; leave both unset
# (the default) to keep every caller on session-cookie auth only. Must match
# JOBAGENT_API_KEY in that JobAgent installation's own .env, generated with:
# python -c "import secrets; print(secrets.token_hex(32))"
# JOBAGENT_API_KEY_USER_ID is that account's numeric id — check with:
# sudo -u postgres psql -d jobagent -c "SELECT id, username FROM users;"
# require_admin rejects key-authenticated requests outright regardless of
# whose user_id this points at, but it's still good practice to point this at
# a plain non-admin account — the key otherwise inherits get_current_user's
# full scope for that user_id, and unlike a session it has no expiry or
# logout short of editing this file and restarting.
JOBAGENT_API_KEY=
JOBAGENT_API_KEY_USER_ID=
